describe("MS Project XML import", () => {
  const s = parseMspdi(MSP);

  it("reads tasks, WBS from summaries, status and baseline", () => {
    expect(s.projectName).toBe("Tower A");
    expect(s.wbs.map((w) => w.name)).toEqual(["Structure"]);
    expect(s.activities.map((a) => a.code)).toEqual(["T2", "T3", "T4"]);
    const cols = s.activities[0];
    expect(cols.status).toBe("complete");
    expect(cols.originalDurationHours).toBe(16);
    expect(cols.wbsId).toBe("w1");
    expect(s.activities[2].type).toBe("milestone");
  });

  it("reads links with lag, constraints, calendars and resources", () => {
    const r = s.relationships.find((x) => x.successorId === "3")!;
    expect(r.type).toBe("FS");
    expect(r.lagHours).toBe(8); // 4800 tenths of a minute
    expect(s.relationships.some((x) => x.predecessorId === "1")).toBe(false); // link from a summary dropped
    expect(s.activities[1].constraint?.type).toBe("start-on-or-after");
    expect(s.calendars![0].week[1]).toEqual([[8, 12], [13, 17]]);
    expect(s.calendars![0].holidays).toEqual([Date.UTC(2026, 2, 10)]);
    expect(s.resources![0].pricePerUnit).toBe(45);
    expect(s.assignments![0].budgetQty).toBe(96);
  });

  it("can be scheduled", () => {
    const r = scheduleCpm(s);
    const slab = r.schedule.activities.find((a) => a.code === "T3")!;
    // Columns done Tue 17:00, +8h lag => Wed 17:00 start; data date Wed 08:00 => start Thu 08:00
    expect(slab.start).toBe(Date.UTC(2026, 2, 5, 8));
  });

  it("parses ISO durations and rejects non-MSP XML", () => {
    expect(parseMspDuration("PT7H30M0S")).toBe(7.5);
    expect(parseMspDuration("P1DT2H")).toBe(26);
    expect(() => parseMspdi("<foo/>")).toThrow(/Microsoft Project/);
  });
});

describe("XER export", () => {
  const demo = parseXer(demoXer());

  it("round-trips through XER and keeps untouched tables", () => {
    const back = parseXer(decodeXer(exportXer(demo)));
    expect(back.activities).toHaveLength(demo.activities.length);
    expect(back.relationships).toHaveLength(demo.relationships.length);
    expect(back.activities.find((a) => a.code === "ST-210")!.codes.Zone).toBe("Z1");
    expect(back.activities.find((a) => a.code === "ST-210")!.finish).toBe(demo.activities.find((a) => a.code === "ST-210")!.finish);
  });

  it("writes CPM results, new activities and new logic", () => {
    const edited = structuredClone(demo);
    edited.activities.push({ ...edited.activities.find((a) => a.code === "ST-310")!, id: "new-1", code: "ST-320", name: "Roof waterproofing – Zone 2", status: "not-started", actualStart: null, actualFinish: null, percentComplete: 0 });
    edited.relationships.push({ id: "r-new", predecessorId: "1080", successorId: "new-1", type: "FS", lagHours: 0 });
    const r = scheduleCpm(edited);
    const tables = scheduleToXerTables(r.schedule);
    const row = tables.TASK.find((t) => t.task_code === "ST-320")!;
    expect(Number(row.task_id)).toBeGreaterThan(1120);
    expect(row.late_end_date).toMatch(/^2026-/);
    expect(tables.TASKPRED.some((p) => p.task_id === row.task_id && p.pred_task_id === "1080")).toBe(true);
    const text = writeXer(tables);
    expect(text.startsWith("ERMHDR")).toBe(true);
    expect(text.trimEnd().endsWith("%E")).toBe(true);
    const back = parseXer(decodeXer(encodeWindows1252(text)));
    expect(back.activities.find((a) => a.code === "ST-320")!.name).toBe("Roof waterproofing – Zone 2");
  });

  it("builds a minimal XER for schedules from MS Project", () => {
    const s = parseMspdi(MSP);
    const back = parseXer(decodeXer(exportXer(s)));
    expect(back.activities.map((a) => a.code)).toEqual(["T2", "T3", "T4"]);
    expect(back.calendars![0].week[1]).toEqual([[8, 12], [13, 17]]);
  });

  it("exports CSV", () => {
    const csv = exportCsv(demo);
    expect(csv.split("\r\n")).toHaveLength(demo.activities.length + 1);
    expect(csv).toContain("Level 1 Slab");
  });
