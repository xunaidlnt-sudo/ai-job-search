# Copy to .env and change both values.
# STRATUM_SECRET signs sign-in sessions and encrypts stored SMTP/P6 passwords:
# keep it secret, and do not change it later or stored passwords can't be read.
STRATUM_SECRET=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me-too
STRATUM_PORT=8080
# Optional: company root certificate for P6 servers secured by an in-house CA
# (mount the file into the container and point at it), and an outbound proxy.
# NODE_EXTRA_CA_CERTS=/certs/company-root.pem
# HTTPS_PROXY=http://proxy.company.local:8080
# NO_PROXY=localhost,127.0.0.1
