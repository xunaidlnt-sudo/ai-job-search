{
  "name": "stratum-4d",
  "version": "0.3.0",
  "private": true,
  "description": "Stratum: 4D construction planning. Links P6 schedules to IFC models and plays back the build sequence.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "desktop": "npm run build && npm run build:electron && electron . --no-sandbox",
    "dist": "npm run build && npm run build:electron && electron-builder --publish never",
    "dist:win": "npm run build && npm run build:electron && electron-builder --win --publish never",
    "dist:mac": "npm run build && npm run build:electron && electron-builder --mac --publish never",
    "dist:linux": "npm run build && npm run build:electron && electron-builder --linux --publish never",
    "samples": "vite-node scripts/gen-samples.ts",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=server-dist/server.cjs --external:playwright --external:playwright-core --external:oracledb --external:pg-native --log-level=warning && cp node_modules/sql.js/dist/sql-wasm.wasm server-dist/",
    "server": "node server-dist/server.cjs",
    "build:electron": "esbuild electron/host.ts --bundle --platform=node --target=node20 --format=cjs --outfile=electron/host.cjs --external:electron --external:oracledb --external:pg-native --external:playwright --external:playwright-core --log-level=warning && cp node_modules/sql.js/dist/sql-wasm.wasm electron/"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "oracledb": "^6.7.0"
  },
  "devDependencies": {
    "@fastify/static": "^8.0.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mssql": "^9.1.5",
    "@types/nodemailer": "^6.4.17",
    "@types/oracledb": "^6.5.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/smtp-server": "^3.5.10",
    "@types/sql.js": "^1.4.9",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^2.4.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^4.5.0",
    "fastify": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^11.0.1",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smtp-server": "^3.13.6",
    "sql.js": "^1.12.0",
    "three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "web-ifc": "^0.0.66",
    "zustand": "^5.0.2"
  },
  "main": "electron/main.cjs",
  "author": {
    "name": "Junaid Quamar",
    "url": "https://www.linkedin.com/in/junaidquamar/"
  },
  "homepage": "https://github.com/xunaidlnt-sudo/ai-job-search/tree/stratum-4d",
  "build": {
    "appId": "com.stratum4d.app",
    "productName": "Stratum 4D",
    "copyright": "Copyright © 2026 Junaid Quamar",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/host.cjs",
      "electron/sql-wasm.wasm",
      "package.json"
    ],
    "artifactName": "Stratum-4D-${version}-${os}-${arch}.${ext}",
    "fileAssociations": [
      {
        "ext": "xer",
        "name": "Primavera P6 XER",
        "role": "Viewer"
      },
      {
        "ext": "ifc",
        "name": "IFC Model",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Stratum 4D",
      "license": "build/license.txt",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "Stratum 4D ${version}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "Stratum <xunaidlnt@gmail.com>",
      "synopsis": "4D construction planning"
    },
    "publish": []
  },
  "contributors": [
    {
      "name": "Junaid Quamar",
      "url": "https://www.linkedin.com/in/junaidquamar/"
    }
  ]
}
